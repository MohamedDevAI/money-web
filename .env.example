# ─── IIFL Capital | Markets' APIs (v1) Credentials ───
# App Name: MoneyHubTrader
VITE_IIFL_GATEWAY_URL=https://api.iiflcapital.com/v1
VITE_IIFL_BASE_URL=/api/iifl
VITE_IIFL_APP_KEY=
VITE_IIFL_SECRET_KEY=
VITE_IIFL_CLIENT_ID=
# Optional: Daily Auth Code (from IIFL SSO redirect) or pre-generated User Session token
VITE_IIFL_AUTH_CODE=
VITE_IIFL_USER_SESSION=

# ─── Spring Boot + MongoDB Backend Target ───
VITE_BACKEND_URL=http://localhost:8080
